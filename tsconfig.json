{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,

    "module": "ESNext",
    "target": "ES2018",

    "moduleResolution": "node",
    "isolatedModules": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "allowJs": true,
    "importHelpers": true,

    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,  
    "skipLibCheck": true,

    "lib": ["DOM", "ES2018"]
  },
  "include": ["**/*.ts"]
}
